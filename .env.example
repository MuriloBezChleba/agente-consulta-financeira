# Copie este arquivo para .env e preencha com valores locais.
# .env nunca deve ser commitado (ver .gitignore).

# --- Banco de dados (MySQL local via Docker) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=financeiro
DB_USER=app_user
DB_PASSWORD=troque_esta_senha_localmente

# --- Embeddings para RAG (build.nvidia.com / NVIDIA NIM) ---
# Gere sua chave gratuita em https://build.nvidia.com
# Usada so para os embeddings do RAG (rag.py). O chat usa Groq (abaixo).
NVIDIA_API_KEY=
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# --- LLM de chat (console.groq.com) ---
# Gere sua chave gratuita em https://console.groq.com — free tier bem mais folgado
# que o da NVIDIA para chat/completions.
GROQ_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# --- LocalStack (emulação AWS local, não são credenciais reais) ---
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1

# --- Filas/Tópicos (preenchidos após setup_aws.sh criar os recursos) ---
SQS_QUEUE_URL=
SNS_TOPIC_ARN=
