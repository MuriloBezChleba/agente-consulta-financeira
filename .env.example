# Copie este arquivo para .env e preencha com valores locais.
# .env nunca deve ser commitado (ver .gitignore).

# --- Banco de dados (MySQL local via Docker) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=financeiro
DB_USER=app_user
DB_PASSWORD=troque_esta_senha_localmente

# --- LLM (build.nvidia.com / NVIDIA NIM) ---
# Gere sua chave gratuita em https://build.nvidia.com
NVIDIA_API_KEY=
# meta/llama-3.1-8b-instruct: mais rapido e estavel no free tier, bom pra dev/testes.
# meta/llama-3.3-70b-instruct: melhor qualidade de raciocinio, mas free tier pode
# enfileirar/ter timeout sob uso intenso. Trocar aqui conforme a necessidade.
LLM_MODEL=meta/llama-3.1-8b-instruct

# --- LocalStack (emulação AWS local, não são credenciais reais) ---
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1

# --- Filas/Tópicos (preenchidos após setup_aws.sh criar os recursos) ---
SQS_QUEUE_URL=
SNS_TOPIC_ARN=
